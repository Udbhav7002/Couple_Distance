<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base translucent dark glass for contrast against bright wallpapers -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/widget_glass_base" />
        </shape>
    </item>

    <!-- Translucent frosted glass gradient with specular reflection -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#47FFFFFF"
                android:centerColor="#22FFFFFF"
                android:endColor="#14FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="@color/widget_glass_stroke" />
        </shape>
    </item>
</layer-list>

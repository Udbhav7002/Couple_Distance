<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base velvety dark matte surface -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/widget_glass_base" />
        </shape>
    </item>

    <!-- Subtle micro-border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_glass_stroke" />
        </shape>
    </item>
</layer-list>
